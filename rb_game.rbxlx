          <string name="Name">MapConfig</string>
          <string name="Source"><![CDATA[-- Настройки карты. Меняй числа здесь — карта перестроится при следующем запуске.
-- Координаты: X — вбок, Y — вверх, Z — вперёд (в студах).

local MapConfig = {}

MapConfig.Ground = {
	Size = Vector3.new(400, 2, 400),
	Color = Color3.fromRGB(86, 160, 72),
	Material = Enum.Material.Grass,
}

MapConfig.Spawn = {
	Position = Vector3.new(0, 1.5, 0),
	Size = Vector3.new(12, 1, 12),
}

-- Каждый этап: платформа + чекпоинт в конце.
-- Kind: "Platform" — обычная, "Kill" — убивает при касании,
-- "Moving" — двигается туда-обратно, "Checkpoint" — точка сохранения.
MapConfig.Stages = {
	{ Kind = "Platform", Position = Vector3.new(0, 3, 14), Size = Vector3.new(8, 1, 8) },
	{ Kind = "Platform", Position = Vector3.new(0, 5, 26), Size = Vector3.new(6, 1, 6) },
	{ Kind = "Platform", Position = Vector3.new(4, 7, 37), Size = Vector3.new(5, 1, 5) },
	{ Kind = "Checkpoint", Position = Vector3.new(6, 8, 49), Size = Vector3.new(10, 1, 10) },

	{ Kind = "Kill", Position = Vector3.new(6, 8, 62), Size = Vector3.new(10, 1, 14) },
	{ Kind = "Platform", Position = Vector3.new(6, 10, 58), Size = Vector3.new(3, 1, 3) },
	{ Kind = "Platform", Position = Vector3.new(6, 10, 64), Size = Vector3.new(3, 1, 3) },
	{ Kind = "Platform", Position = Vector3.new(6, 11, 72), Size = Vector3.new(6, 1, 6) },
	{ Kind = "Checkpoint", Position = Vector3.new(6, 12, 83), Size = Vector3.new(10, 1, 10) },

	{ Kind = "Moving", Position = Vector3.new(6, 13, 95), Size = Vector3.new(6, 1, 6), Offset = Vector3.new(10, 0, 0), Time = 2 },
	{ Kind = "Moving", Position = Vector3.new(6, 15, 106), Size = Vector3.new(6, 1, 6), Offset = Vector3.new(0, 6, 0), Time = 1.5 },
	{ Kind = "Platform", Position = Vector3.new(6, 22, 117), Size = Vector3.new(6, 1, 6) },
	{ Kind = "Checkpoint", Position = Vector3.new(6, 23, 128), Size = Vector3.new(14, 1, 14), Finish = true },
}

MapConfig.Colors = {
	Platform = Color3.fromRGB(240, 200, 60),
	Kill = Color3.fromRGB(220, 40, 40),
	Moving = Color3.fromRGB(70, 140, 240),
	Checkpoint = Color3.fromRGB(40, 220, 120),
	Finish = Color3.fromRGB(255, 255, 255),
}

-- Высота, ниже которой игрок считается упавшим и возвращается на чекпоинт.
MapConfig.FallHeight = -20

return MapConfig
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="6">
        <Properties>
          <string name="Name">MapBuilder</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Строит карту из ReplicatedStorage.Shared.MapConfig.
-- Если в Workspace уже есть папка "Map" (собранная руками в Studio), скрипт её не трогает.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local MapConfig = require(ReplicatedStorage.Shared.MapConfig)

if workspace:FindFirstChild("Map") then
	return
end

local map = Instance.new("Folder")
map.Name = "Map"

local function makePart(name, size, position, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.Position = position
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local ground = MapConfig.Ground
makePart("Ground", ground.Size, Vector3.new(0, -ground.Size.Y / 2, 0), ground.Color, ground.Material, map)

local spawn = Instance.new("SpawnLocation")
spawn.Name = "Spawn"
spawn.Anchored = true
spawn.Size = MapConfig.Spawn.Size
spawn.Position = MapConfig.Spawn.Position
spawn.Color = MapConfig.Colors.Checkpoint
spawn.Material = Enum.Material.Neon
spawn.Duration = 0
spawn.Parent = map

local checkpoints = Instance.new("Folder")
checkpoints.Name = "Checkpoints"
checkpoints.Parent = map

local stageNumber = 0

for index, stage in MapConfig.Stages do
	local color = MapConfig.Colors[stage.Kind] or MapConfig.Colors.Platform
	local name = string.format("%02d_%s", index, stage.Kind)

	if stage.Kind == "Checkpoint" then
		stageNumber += 1
		local part = makePart(name, stage.Size, stage.Position,
			stage.Finish and MapConfig.Colors.Finish or color, Enum.Material.Neon, checkpoints)
		part:SetAttribute("Stage", stageNumber)
		part:SetAttribute("Finish", stage.Finish == true)
	elseif stage.Kind == "Kill" then
		local part = makePart(name, stage.Size, stage.Position, color, Enum.Material.Neon, map)
		part:AddTag("Kill")
	elseif stage.Kind == "Moving" then
		local part = makePart(name, stage.Size, stage.Position, color, Enum.Material.SmoothPlastic, map)
		local info = TweenInfo.new(stage.Time or 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		TweenService:Create(part, info, { Position = stage.Position + (stage.Offset or Vector3.zero) }):Play()
	else
		makePart(name, stage.Size, stage.Position, color, Enum.Material.SmoothPlastic, map)
	end
end

map.Parent = workspace
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Stages</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Чекпоинты, kill-блоки и возврат упавших игроков.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapConfig = require(ReplicatedStorage.Shared.MapConfig)

local map = workspace:WaitForChild("Map")
local checkpoints = map:WaitForChild("Checkpoints")
local spawn = map:WaitForChild("Spawn")

local function getHumanoid(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	return character and character:FindFirstChildOfClass("Humanoid"), character
end

local function findCheckpoint(stage)
	for _, part in checkpoints:GetChildren() do
		if part:GetAttribute("Stage") == stage then
			return part
		end
	end
	return nil
end

local function respawnPoint(player)
	local stage = player:FindFirstChild("leaderstats") and player.leaderstats.Stage.Value or 0
	local checkpoint = findCheckpoint(stage)
	local target = checkpoint or spawn
	return target.CFrame + Vector3.new(0, target.Size.Y / 2 + 3, 0)
end

local function onPlayerAdded(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local stage = Instance.new("IntValue")
	stage.Name = "Stage"
	stage.Parent = leaderstats

	local function onCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart")
		task.defer(function()
			root.CFrame = respawnPoint(player)
		end)
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end

for _, checkpoint in checkpoints:GetChildren() do
	checkpoint.Touched:Connect(function(hit)
		local humanoid, character = getHumanoid(hit)
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local stage = player.leaderstats.Stage
		local reached = checkpoint:GetAttribute("Stage")
		if reached > stage.Value then
			stage.Value = reached
			if checkpoint:GetAttribute("Finish") then
				print(player.Name .. " прошёл карту!")
			end
		end
	end)
end

local function bindKill(part)
	part.Touched:Connect(function(hit)
		local humanoid = getHumanoid(hit)
		if humanoid then
			humanoid.Health = 0
		end
	end)
end

for _, part in CollectionService:GetTagged("Kill") do
	bindKill(part)
end
CollectionService:GetInstanceAddedSignal("Kill"):Connect(bindKill)

RunService.Heartbeat:Connect(function()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root.Position.Y < MapConfig.FallHeight then
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = respawnPoint(player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>